# Скопируйте файл в .env и замените значения перед запуском Docker Compose.
# Пароль PostgreSQL: сгенерируйте командой openssl rand -hex 16.
POSTGRES_PASSWORD=replace_with_random_hex_password

# Ключ JWT: сгенерируйте командой openssl rand -hex 32 (минимум 32 символа).
JWT_SECRET_KEY=replace_with_random_secret_at_least_32_characters

# Для запуска FastAPI вне Docker задайте DATABASE_URL отдельно.
# Пароль должен совпадать с POSTGRES_PASSWORD; PostgreSQL должен быть доступен на localhost.
# Docker Compose сам задаёт DATABASE_URL с адресом сервиса postgres.
# DATABASE_URL=postgresql+asyncpg://metal_detection:replace_with_random_hex_password@localhost:5432/metal_detection
